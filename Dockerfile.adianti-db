# Usar a imagem oficial do PostgreSQL
FROM postgres:17

# Definir variáveis de ambiente (mude conforme necessário)
ENV POSTGRES_DB=atendente
ENV POSTGRES_USER=atendente
ENV POSTGRES_PASSWORD=atendente123

# Instala pgvector para PostgreSQL 17
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-17-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Scripts SQL serão montados via bind mount em docker-compose.yml

# Expor a porta padrão do PostgreSQL
EXPOSE 5432
