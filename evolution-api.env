# Evolution API configuration
# Change this to a strong random value
AUTHENTICATION_API_KEY=change-me

# WhatsApp/Baileys session compatibility
# Pin the phone protocol version to avoid the QR count=0 reconnect loop.
SERVER_URL=http://localhost:8090
QRCODE_LIMIT=30
QRCODE_COLOR=#198754
CONFIG_SESSION_PHONE_VERSION=2.3000.1030831524
CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome

# Global webhook (sent for all instances)
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_URL=http://n8n:5678/webhook/evolution-ai-agent
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# Events
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true

# Database (PostgreSQL)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://atendente:atendente123@postgres:5432/atendente?schema=evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# Redis (Evolution API v2 uses CACHE_REDIS_*)
CACHE_REDIS_ENABLED=false
CACHE_REDIS_URI=redis://redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=true

# Avoid Baileys pre-key/QR timeouts while the history payload is being saved.
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false
